@page "/tickets"
@using Microsoft.AspNetCore.Components.Sections
@using Domain.DTO.Request
@using Domain.Interfaces
@using MudBlazor
@using TicketManagement.UI.Components.Shared
@inject ITicketService TicketService

<SectionContent SectionName="page-title">Tickets</SectionContent>

<div class="ticket-container">
    <div class="ticket-header">
        <div class="ticket-header-content">
            <div>
                <h1 class="ticket-title">
                    <i class="fa-solid fa-inbox"></i>
                    Tickets
                </h1>
                <p class="ticket-subtitle">Manage and track all support tickets</p>
            </div>
            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Add"
                       Color="Color.Primary"
                       Class="ticket-create-btn">
                Create Ticket
            </MudButton>
        </div>
    </div>

    <div class="ticket-content">
        <div class="ticket-filters">
            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MultiSelect T="string"
                                 Label="Status"
                                 Items="@statusOptions"
                                 @bind-SelectedValues="@selectedStatuses"
                                 Dense="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MultiSelect T="string"
                                 Label="Priority"
                                 Items="@priorityOptions"
                                 @bind-SelectedValues="@selectedPriorities"
                                 Dense="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MultiSelect T="string"
                                 Label="Category"
                                 Items="@categoryOptions"
                                 @bind-SelectedValues="@selectedCategories"
                                 Dense="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MultiSelect T="string"
                                 Label="Product"
                                 Items="@productOptions"
                                 @bind-SelectedValues="@selectedProducts"
                                 Dense="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MultiSelect T="string"
                                 Label="Created By"
                                 Items="@createdByOptions"
                                 @bind-SelectedValues="@selectedCreatedBy"
                                 Dense="true" />
                </MudItem>
                <MudItem xs="12" Class="d-flex justify-end">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.FilterAltOff"
                               OnClick="ResetFilters">
                        Reset Filters
                    </MudButton>
                </MudItem>
            </MudGrid>
        </div>

        <MudDataGrid T="GetTicketResponseDto"
                     Items="@tickets"
                     Filterable="false"
                     SortMode="SortMode.Multiple"
                     Dense="false"
                     Hover="true"
                     Class="ticket-grid"
                     Loading="@isLoading"
                     LoadingProgressColor="Color.Primary">

            <Columns>
                <PropertyColumn Property="x => x.TicketIdView"
                               Title="ID"
                               Sortable="true"
                               Filterable="true">
                    <CellTemplate>
                        <div class="ticket-id-badge">
                            @context.Item.TicketIdView
                        </div>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Summary"
                               Title="Summary"
                               Sortable="true"
                               Filterable="true">
                    <CellTemplate>
                        <div class="ticket-summary">
                            <strong>@context.Item.Summary</strong>
                            @if (!string.IsNullOrEmpty(context.Item.Description))
                            {
                                <div class="ticket-description-preview">
                                    @(context.Item.Description.Length > 60
                                        ? context.Item.Description.Substring(0, 60) + "..."
                                        : context.Item.Description)
                                </div>
                            }
                        </div>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Priority"
                               Title="Priority"
                               Sortable="true"
                               Filterable="true">
                    <CellTemplate>
                        <MudChip Size="Size.Small"
                                 Color="@GetPriorityColor(context.Item.Priority)"
                                 Class="ticket-chip">
                            @context.Item.Priority
                        </MudChip>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Status"
                               Title="Status"
                               Sortable="true"
                               Filterable="true">
                    <CellTemplate>
                        <MudChip Size="Size.Small"
                                 Color="@GetStatusColor(context.Item.Status)"
                                 Class="ticket-chip">
                            @context.Item.Status
                        </MudChip>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Category"
                               Title="Category"
                               Sortable="true"
                               Filterable="true"/>

                <PropertyColumn Property="x => x.Product"
                               Title="Product"
                               Sortable="true"
                               Filterable="true"/>

                <PropertyColumn Property="x => x.CreatedBy"
                               Title="Created By"
                               Sortable="true"
                               Filterable="true"/>

                <PropertyColumn Property="x => x.CreatedDate"
                               Title="Created"
                               Sortable="true"
                               Filterable="false">
                    <CellTemplate>
                        <div class="ticket-date">
                            @context.Item.CreatedDate.ToString("MMM dd, yyyy")
                            <div class="ticket-date-time">
                                @context.Item.CreatedDate.ToString("hh:mm tt")
                            </div>
                        </div>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.DueDate"
                               Title="Due Date"
                               Sortable="true"
                               Filterable="false">
                    <CellTemplate>
                        @if (context.Item.DueDate.HasValue)
                        {
                            <div class="ticket-date @(context.Item.DueDate.Value < DateTime.Now ? "ticket-overdue" : "")">
                                @context.Item.DueDate.Value.ToString("MMM dd, yyyy")
                            </div>
                        }
                        else
                        {
                            <span class="ticket-no-date">—</span>
                        }
                    </CellTemplate>
                </PropertyColumn>

                <TemplateColumn Filterable="false"
                               Sortable="false"
                               Title="Actions">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                      Size="Size.Small"
                                      Color="Color.Primary"/>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                      Size="Size.Small"
                                      Color="Color.Default"/>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>

            <PagerContent>
                <MudDataGridPager T="GetTicketResponseDto"
                                 PageSizeOptions="new int[] { 10, 25, 50, 100 }"/>
            </PagerContent>
        </MudDataGrid>
    </div>
</div>

@rendermode InteractiveServer

@code {
    private List<GetTicketResponseDto> tickets = new();
    private List<GetTicketResponseDto> allTickets = new();
    private bool isLoading = true;

    // Filter options
    private List<string> statusOptions = new();
    private List<string> priorityOptions = new();
    private List<string> categoryOptions = new();
    private List<string> productOptions = new();
    private List<string> createdByOptions = new();

    // Selected filters
    private IEnumerable<string> _selectedStatuses = new List<string>();
    private IEnumerable<string> _selectedPriorities = new List<string>();
    private IEnumerable<string> _selectedCategories = new List<string>();
    private IEnumerable<string> _selectedProducts = new List<string>();
    private IEnumerable<string> _selectedCreatedBy = new List<string>();

    private IEnumerable<string> selectedStatuses
    {
        get => _selectedStatuses;
        set { _selectedStatuses = value; ApplyFilters(); }
    }

    private IEnumerable<string> selectedPriorities
    {
        get => _selectedPriorities;
        set { _selectedPriorities = value; ApplyFilters(); }
    }

    private IEnumerable<string> selectedCategories
    {
        get => _selectedCategories;
        set { _selectedCategories = value; ApplyFilters(); }
    }

    private IEnumerable<string> selectedProducts
    {
        get => _selectedProducts;
        set { _selectedProducts = value; ApplyFilters(); }
    }

    private IEnumerable<string> selectedCreatedBy
    {
        get => _selectedCreatedBy;
        set { _selectedCreatedBy = value; ApplyFilters(); }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadTickets();
        InitializeFilterOptions();
    }

    private async Task LoadTickets()
    {
        isLoading = true;
        try
        {
            var request = new GetTicketsRequestDto();
            allTickets = TicketService.GetTickets(request);
            tickets = allTickets;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void InitializeFilterOptions()
    {
        statusOptions = allTickets.Select(t => t.Status).Distinct().OrderBy(s => s).ToList();
        priorityOptions = allTickets.Select(t => t.Priority).Distinct().OrderBy(p => p).ToList();
        categoryOptions = allTickets.Select(t => t.Category).Distinct().OrderBy(c => c).ToList();
        productOptions = allTickets.Select(t => t.Product).Distinct().OrderBy(p => p).ToList();
        createdByOptions = allTickets.Select(t => t.CreatedBy).Distinct().OrderBy(c => c).ToList();
    }

    private void ApplyFilters()
    {
        tickets = allTickets.Where(t =>
            (selectedStatuses?.Any() != true || selectedStatuses.Contains(t.Status)) &&
            (selectedPriorities?.Any() != true || selectedPriorities.Contains(t.Priority)) &&
            (selectedCategories?.Any() != true || selectedCategories.Contains(t.Category)) &&
            (selectedProducts?.Any() != true || selectedProducts.Contains(t.Product)) &&
            (selectedCreatedBy?.Any() != true || selectedCreatedBy.Contains(t.CreatedBy))
        ).ToList();
    }

    private void ResetFilters()
    {
        selectedStatuses = new List<string>();
        selectedPriorities = new List<string>();
        selectedCategories = new List<string>();
        selectedProducts = new List<string>();
        selectedCreatedBy = new List<string>();
        tickets = allTickets;
    }

    private Color GetPriorityColor(string priority)
    {
        return priority?.ToLower() switch
        {
            "critical" => Color.Error,
            "high" => Color.Warning,
            "medium" => Color.Info,
            "low" => Color.Default,
            _ => Color.Default
        };
    }

    private Color GetStatusColor(string status)
    {
        return status?.ToLower() switch
        {
            "open" => Color.Info,
            "in progress" => Color.Primary,
            "resolved" => Color.Success,
            "closed" => Color.Default,
            "on hold" => Color.Warning,
            _ => Color.Default
        };
    }
}