@page "/processor/{encryptedLoginPayload}"

@using Domain.Entities
@using Microsoft.AspNetCore.Identity
@using TicketManagement.UI.Components.DTO
@using TicketManagement.UI.Components.Layout
@using TicketManagement.UI.Components.Security
@layout EmptyLayout

@inject SignInManager<User> signInManager
@inject NavigationManager navigationManager
@inject EncryptionHelper<LoginDto> encryptionHelper

Sign In....

@code
{
    [Parameter] public string payload { get; set; }
    // [Parameter] public string password { get; set; }
    // [Parameter] public bool rememberMe{ get; set; }

    protected override async Task OnInitializedAsync()
    {
        var loginDto = encryptionHelper.Decode(payload);
        await signInManager.PasswordSignInAsync(loginDto.Username, loginDto.Password, loginDto.RememberMe, false);
        navigationManager.NavigateTo("/");
    }

}
