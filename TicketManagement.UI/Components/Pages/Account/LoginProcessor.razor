@page "/processor/{username}/{password}/{rememberMe:bool}"

@using Domain.Entities
@using Microsoft.AspNetCore.Identity
@using TicketManagement.UI.Components.Layout
@layout EmptyLayout

@inject SignInManager<User> signInManager
@inject NavigationManager navigationManager

Sign In....

@code
{
    [Parameter] public string username { get; set; }
    [Parameter] public string password { get; set; }
    [Parameter] public bool rememberMe{ get; set; }

    protected override async Task OnInitializedAsync()
    {
        await signInManager.PasswordSignInAsync(username, password, rememberMe, false);
        navigationManager.NavigateTo("/");
    }

}
